# ==============================================================================
# IncuBrix Video Editing Engine - Environment Configuration Template
# All settings default gracefully for both single-container cloud and distributed Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# API & Security
# ------------------------------------------------------------------------------
API_TITLE="IncuBrix Prompt-Based Video Editing Engine API"
API_VERSION="1.0.0"

# Optional Bearer token for API protection. Leave empty for open access.
# API_ACCESS_TOKEN=your-secure-bearer-token-here

# Per-client request rate limit per minute
RATE_LIMIT_PER_MINUTE=120

# Shared HMAC secret for signing asynchronous webhook delivery
WEBHOOK_SECRET=incubrix-shared-secret-key

# ------------------------------------------------------------------------------
# Storage Backend
# Auto-detected: 's3' if MINIO_ENDPOINT is set; 'local' if omitted.
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage

# MinIO / AWS S3 Settings (Required only when STORAGE_BACKEND=s3)
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=incubrix-media
# MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Queue Backend
# Auto-detected: 'redis' if REDIS_URL is set; 'inprocess' if omitted.
# ------------------------------------------------------------------------------
QUEUE_BACKEND=inprocess

# Redis Queue Connection (Required only when QUEUE_BACKEND=redis)
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Database Connection
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/incubrix.db

# ------------------------------------------------------------------------------
# AI & Speech Models
# ------------------------------------------------------------------------------
# faster-whisper model size (small.en, base.en, tiny.en)
WHISPER_MODEL=small.en

# Optional Google Gemini API key for structured intent parsing.
# If omitted, engine uses deterministic rule parser + MockAdapter with zero external calls.
# GEMINI_API_KEY=your-gemini-api-key-here
